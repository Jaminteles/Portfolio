---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionLabel from '@/components/SectionLabel.astro';
import Icon, { type IconName } from '@/components/Icon.astro';
import type { Locale } from '@/i18n/ui';
import { routeAlternates, useTranslations } from '@/i18n/utils';
import { SITE } from '@/data/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const channels: { icon: IconName; name: string; cta: string; handle: string; href: string; external: boolean }[] = [
  {
    icon: 'linkedin',
    name: 'LinkedIn',
    cta: t('contact.linkedin'),
    handle: `in/${SITE.linkedinUser}`,
    href: SITE.linkedin,
    external: true,
  },
  {
    icon: 'github',
    name: 'GitHub',
    cta: t('contact.github'),
    handle: `@${SITE.githubUser}`,
    href: SITE.github,
    external: true,
  },
  {
    icon: 'mail',
    name: 'E-mail',
    cta: t('contact.email'),
    handle: SITE.email,
    href: `mailto:${SITE.email}`,
    external: false,
  },
];
---

<BaseLayout
  locale={locale}
  title={t('contact.title')}
  description={t('contact.metaDescription')}
  current="contact"
  alternates={routeAlternates('contact')}
>
  <section class="bg-blueprint border-b border-line">
    <div class="container-page py-14 sm:py-20">
      <SectionLabel index="01">{t('nav.contact')}</SectionLabel>
      <h1 class="mt-3 text-4xl font-bold sm:text-5xl">{t('contact.title')}</h1>
      <p class="mt-4 max-w-2xl text-lg text-muted">{t('contact.intro')}</p>
    </div>
  </section>

  <div class="container-page py-12 sm:py-16">
    <ul class="grid gap-4 md:grid-cols-3">
      {
        channels.map((c) => (
          <li class="card group relative flex flex-col gap-6 p-6 transition-colors hover:border-accent">
            <span class="grid size-12 place-items-center rounded-lg bg-accent-soft text-accent">
              <Icon name={c.icon} size={24} />
            </span>
            <div>
              <h2 class="text-xl font-semibold">
                <a
                  href={c.href}
                  target={c.external ? '_blank' : undefined}
                  rel={c.external ? 'noopener noreferrer' : undefined}
                  class="outline-none after:absolute after:inset-0 after:rounded-lg focus-visible:after:outline-2 focus-visible:after:outline-offset-2 focus-visible:after:outline-accent"
                >
                  {c.name}
                  {c.external && <span class="sr-only">{t('a11y.newTab')}</span>}
                </a>
              </h2>
              <p class="mt-1 text-sm text-muted">{c.cta}</p>
            </div>
            <p class="mt-auto flex items-center justify-between gap-2 border-t border-line pt-4 font-mono text-sm break-all">
              {c.handle}
              <Icon
                name={c.external ? 'arrow-up-right' : 'arrow-right'}
                size={18}
                class="text-accent transition-transform group-hover:translate-x-0.5"
              />
            </p>
          </li>
        ))
      }
    </ul>

    <div class="mt-6 flex justify-center">
      <button
        type="button"
        class="btn btn-ghost font-mono text-xs"
        data-copy-email={SITE.email}
        data-copied-label={t('contact.copied')}
        hidden
      >
        <Icon name="copy" size={16} />
        <span data-copy-label>{t('contact.copy')}</span>
      </button>
      <p class="sr-only" aria-live="polite" data-copy-status></p>
    </div>
  </div>
</BaseLayout>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  if (btn && navigator.clipboard) {
    btn.hidden = false; // só aparece se o navegador suportar a área de transferência
    const label = btn.querySelector<HTMLElement>('[data-copy-label]');
    const original = label?.textContent ?? '';
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copyEmail ?? '');
        if (label) label.textContent = btn.dataset.copiedLabel ?? '';
        if (status) status.textContent = btn.dataset.copiedLabel ?? '';
        setTimeout(() => {
          if (label) label.textContent = original;
        }, 2000);
      } catch {
        /* permissão negada: o link mailto continua disponível */
      }
    });
  }
</script>
