---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '@/styles/global.css';
// Pré-carrega as fontes principais (subset latino) para evitar troca de fonte visível / layout shift.
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import groteskLatin from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';

import SEO from '@/components/SEO.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import WhatsappFab from '@/components/WhatsappFab.astro';
import { LOCALE_META, type Locale, type RouteKey } from '@/i18n/ui';
import { useTranslations, type Alternates } from '@/i18n/utils';
import { SITE } from '@/data/site';

interface Props {
  locale: Locale;
  /** Título da página (sem o sufixo do site). Omitir na Home. */
  title?: string;
  description?: string;
  current?: RouteKey;
  alternates: Alternates;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { locale, title, description, current, alternates, image, imageAlt, type, noindex } = Astro.props;
const t = useTranslations(locale);
const fullTitle = title ? `${title} · ${SITE.name}` : t('meta.title');
---

<!doctype html>
<html lang={LOCALE_META[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f4ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1113" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href={groteskLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- Aplica o tema antes da pintura para evitar "flash" -->
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (e) {}
        const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>

    <SEO
      title={fullTitle}
      description={description ?? t('meta.description')}
      locale={locale}
      alternates={alternates}
      image={image}
      imageAlt={imageAlt}
      type={type}
      noindex={noindex}
    />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#conteudo"
      class="sr-only z-50 rounded-md bg-accent px-4 py-2 font-semibold text-on-accent focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      {t('a11y.skip')}
    </a>
    <Header locale={locale} current={current} alternates={alternates} />
    <main id="conteudo" tabindex="-1" class="flex-1 outline-none">
      <slot />
    </main>
    <Footer locale={locale} />
    <WhatsappFab locale={locale} />
  </body>
</html>
