---
import type { TimelineItem } from '@/data/about';

interface Props {
  items: TimelineItem[];
}
const { items } = Astro.props;
---

<ol class="relative space-y-8 border-l border-line pl-6">
  {
    items.map((item) => (
      <li class="relative">
        <span aria-hidden="true" class="absolute top-1.5 -left-[30px] size-2.5 rotate-45 border-2 border-accent bg-bg" />
        <p class="font-mono text-xs text-muted">{item.period}</p>
        <h3 class="mt-1 text-lg font-semibold">{item.title}</h3>
        <p class="text-sm font-medium text-accent">{item.org}</p>
        <p class="mt-2 leading-relaxed text-muted">{item.description}</p>
        {item.highlights && (
          <ul class="mt-3 space-y-1.5 text-sm">
            {item.highlights.map((h) => (
              <li class="flex gap-2">
                <span aria-hidden="true" class="mt-2 size-1 shrink-0 rounded-full bg-accent" />
                <span>{h}</span>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))
  }
</ol>
