export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  class?: string;
  size?: number;
  /** Se informado, o ícone deixa de ser decorativo e ganha um rótulo acessível. */
  label?: string;
}

const { name, class: className = '', size = 20, label } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['shrink-0', className]}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={icons[name]}
/>
