---
import type { Locale, RouteKey } from '@/i18n/ui';
import { localizePath, useTranslations, type Alternates } from '@/i18n/utils';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  current?: RouteKey;
  alternates: Alternates;
}
const { locale, current, alternates } = Astro.props;
const t = useTranslations(locale);

const links: { key: RouteKey; label: string }[] = [
  { key: 'projects', label: t('nav.projects') },
  { key: 'about', label: t('nav.about') },
  { key: 'contact', label: t('nav.contact') },
];
---

<header class="sticky top-0 z-40 border-b border-line/80 bg-bg/85 backdrop-blur-md">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <Logo locale={locale} />

    <nav aria-label={t('a11y.mainNav')} class="hidden md:block">
      <ul class="flex items-center gap-1">
        {
          links.map(({ key, label }) => (
            <li>
              <a
                href={localizePath(key, locale)}
                aria-current={current === key ? 'page' : undefined}
                class:list={[
                  'relative inline-flex min-h-11 items-center px-3 text-sm font-medium transition-colors',
                  current === key ? 'text-ink' : 'text-muted hover:text-ink',
                  current === key &&
                    'after:absolute after:inset-x-3 after:bottom-2 after:h-0.5 after:rounded-full after:bg-accent',
                ]}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1 sm:gap-2">
      <div class="hidden sm:block">
        <LanguageSwitcher locale={locale} alternates={alternates} label={t('a11y.switchLang')} />
      </div>
      <ThemeToggle label={t('a11y.toggleTheme')} />
      <button
        type="button"
        class="inline-flex size-11 items-center justify-center rounded-md text-ink md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-button
        data-label-open={t('a11y.openMenu')}
        data-label-close={t('a11y.closeMenu')}
        aria-label={t('a11y.openMenu')}
      >
        <span data-icon-open><Icon name="menu" size={22} /></span>
        <span data-icon-close hidden><Icon name="close" size={22} /></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="border-t border-line bg-bg md:hidden" hidden>
    <nav aria-label={t('a11y.mainNav')} class="container-page py-4">
      <ul class="flex flex-col">
        <li>
          <a
            href={localizePath('home', locale)}
            aria-current={current === 'home' ? 'page' : undefined}
            class="flex min-h-12 items-center border-b border-line/60 font-display text-lg font-medium aria-[current=page]:text-accent"
          >
            {t('nav.home')}
          </a>
        </li>
        {
          links.map(({ key, label }) => (
            <li>
              <a
                href={localizePath(key, locale)}
                aria-current={current === key ? 'page' : undefined}
                class="flex min-h-12 items-center border-b border-line/60 font-display text-lg font-medium aria-[current=page]:text-accent"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-4 sm:hidden">
        <LanguageSwitcher locale={locale} alternates={alternates} label={t('a11y.switchLang')} />
      </div>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const menu = document.getElementById('mobile-menu');

  if (button && menu) {
    const iconOpen = button.querySelector<HTMLElement>('[data-icon-open]');
    const iconClose = button.querySelector<HTMLElement>('[data-icon-close]');

    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', (open ? button.dataset.labelClose : button.dataset.labelOpen) ?? '');
      if (iconOpen) iconOpen.hidden = open;
      if (iconClose) iconClose.hidden = !open;
    };

    button.addEventListener('click', () => setOpen(menu.hasAttribute('hidden')));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hasAttribute('hidden')) {
        setOpen(false);
        button.focus();
      }
    });

    matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
