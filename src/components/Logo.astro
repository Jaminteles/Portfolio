---
import type { Locale } from '@/i18n/ui';
import { localizePath } from '@/i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<a
  href={localizePath('home', locale)}
  class="group inline-flex min-h-11 items-center gap-2 font-mono text-sm font-semibold tracking-tight"
>
  <span
    aria-hidden="true"
    class="grid size-8 place-items-center rounded-md bg-accent font-display text-base font-bold text-on-accent transition-transform group-hover:-rotate-6"
    >J</span
  >
  <span>jaminteles<span class="text-accent">_</span></span>
</a>
