---
import { CORE_STACK } from '@/data/site';
import SectionLabel from './SectionLabel.astro';

interface Props {
  label: string;
}
const { label } = Astro.props;
---

<section aria-labelledby="stack-strip-title" class="border-y border-line bg-surface">
  <div class="container-page flex flex-col gap-4 py-6 md:flex-row md:items-center md:gap-10">
    <SectionLabel class="shrink-0"><span id="stack-strip-title">{label}</span></SectionLabel>
    <ul class="flex flex-wrap gap-x-6 gap-y-2 font-display text-base font-medium sm:text-lg">
      {
        CORE_STACK.map((tech) => (
          <li class="flex items-center gap-2">
            <span aria-hidden="true" class="size-1.5 rotate-45 bg-accent" />
            {tech}
          </li>
        ))
      }
    </ul>
  </div>
</section>
