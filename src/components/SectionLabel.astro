---
/** Rótulo no estilo anotação de prancha: "// 01 — PROJETOS" */
interface Props {
  index?: string;
  as?: 'p' | 'span';
  class?: string;
}
const { index, as: Tag = 'p', class: className = '' } = Astro.props;
---

<Tag class:list={['label-mono flex items-center gap-2', className]}>
  <span aria-hidden="true">//</span>
  {index && <span aria-hidden="true">{index} —</span>}
  <slot />
</Tag>
